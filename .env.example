# 이 파일을 복사해 .env로 이름을 바꾸고, 본인이 발급받은 키만 입력하세요.
# 제출판은 키가 없어도 허브 저장 집계 4종과 과거 관측 기록으로 동작합니다.

# Gemini (Google AI Studio 무료 키) - 질문 해석·답변 문장 작성
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Kakao REST API 키 - 내장 목록에 없는 장소 검색 + Kakao Mobility 자동차 예상시간·도로거리
# Kakao Developers 앱에 길찾기 API 사용 설정과 허용 IP 등록이 필요할 수 있습니다.
KAKAO_REST_API_KEY=
# 지도 배경용 JavaScript 플랫폼 키(REST 키와 다름). 비워 두면 기본 지도 사용.
# 카카오맵 사용 ON 및 JavaScript SDK 도메인 http://localhost:8501 등록.
KAKAO_MAP_JS_KEY=

# 공공데이터포털 '한국환경공단_전기자동차 충전소 정보' 인증키(Decoding) - 실시간 충전기 상태
DATA_GO_KR_SERVICE_KEY=

# 제주데이터허브: 프로젝트에서 데이터셋을 먼저 '담기'한 뒤 발급된 값을 입력합니다.
# auto: 키/코드가 있으면 API, 없으면 동봉 집계. snapshot: 키 없이 동봉 집계만. api: API만.
JEJU_DATAHUB_MODE=snapshot
# 프로젝트 키는 화면·로그에 노출되지 않습니다.
JEJU_DATAHUB_PROJECT_KEY=
# 프로젝트 화면의 데이터 번호(1227 등)가 아니라 API 활용안내에 표시되는 데이터 코드를 입력합니다.
# 핵심 1: 요일별 전기자동차 충전 이력
JEJU_DATAHUB_WEEKLY_CHARGE_CODE=
# 핵심 2: 읍면동 단위 내국인 유동인구
JEJU_DATAHUB_FLOATING_DATA_CODE=
# 보조: 일별 전기자동차 대기시간(매칭되는 시설만 위험 보정)
JEJU_DATAHUB_DAILY_WAIT_CODE=
# 검증·결측 보완: 일별 전기자동차 충전 이력
JEJU_DATAHUB_DAILY_CHARGE_CODE=

# 선택: 아래는 초기 조회 범위입니다. 제공처에서 허용한 기간/형식으로 변경할 수 있습니다.
# JEJU_DATAHUB_WEEKLY_START=202206
# JEJU_DATAHUB_WEEKLY_END=202206
# JEJU_DATAHUB_DAILY_START=20220601
# JEJU_DATAHUB_DAILY_END=20220607
# JEJU_DATAHUB_WAIT_START=20220701
# JEJU_DATAHUB_WAIT_END=20221031
# JEJU_DATAHUB_FLOATING_START=20220601
# JEJU_DATAHUB_FLOATING_END=20220601
